generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum RoleCode {
  ADMIN
  SUPERVISOR
  EMPLOYEE
}

// Which portal a multi-role account (e.g. EMPLOYEE + SUPERVISOR) lands on
// right after login. Null means "not chosen yet" — the frontend falls back
// to the pre-existing behavior (non-EMPLOYEE roles land on the admin
// dashboard) until the user picks a preference in Settings.
enum DefaultView {
  ADMIN
  EMPLOYEE
}

enum EmploymentStatus {
  REGULAR
  PROBATIONARY
  CONTRACTUAL_SEASONAL
  PIECE_RATE
  SEPARATED
}

enum SoloParentStatus {
  NOT_APPLICABLE
  ELIGIBLE
  INELIGIBLE
}

// The set of legal attendance modes is DB-driven, not a compiled enum — HR
// assigns a department (and, for a "BOTH" department, an individual employee)
// one of these rows via code, not a hardcoded mapping. See
// EmployeesService.resolveAttendanceMode / DepartmentsService.update.
model AttendanceMode {
  id                      String  @id @default(uuid())
  code                    String  @unique
  label                   String
  description             String?
  sortOrder               Int     @default(0) @map("sort_order")
  isActive                Boolean @default(true) @map("is_active")
  availableForEmployees   Boolean @default(true) @map("available_for_employees")
  availableForDepartments Boolean @default(true) @map("available_for_departments")
  departments             Department[] @relation("DepartmentAttendanceMode")
  employees               Employee[]   @relation("EmployeeAttendanceMode")

  @@map("attendance_modes")
}

// Tags an attendance record as the regular office routine vs a field visit.
// For a FIXED employee this is always OFFICE. For a FIELD employee it's
// auto-detected per visit from the WorkLocation.type of the area they
// actually checked into, so a single FIELD employee can have both OFFICE
// and FIELD records on the same day. Kept as its own column, rather than
// derived on read, so the DTR screen's Office/Field tabs are a simple query.
enum AttendanceRecordType {
  OFFICE
  FIELD
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  OFFICIAL_BUSINESS
  PENDING_REVIEW
  // Synthetic-only, like ABSENT: represents a flagged AttendanceLog with no
  // AttendanceRecord yet. Never written to a real AttendanceRecord.status.
  FLAGGED
}

enum AttendanceLogType {
  TIME_IN
  TIME_OUT
  LUNCH_OUT
  LUNCH_IN
  FAILED_ATTEMPT
}

enum VerificationStatus {
  APPROVED
  REJECTED
  PENDING_REVIEW
  // Admin/supervisor confirmed a mismatched-face attempt was impersonation.
  FAKE_ATTEMPT
  // Admin/supervisor dismissed a flagged attempt without deciding it was
  // legitimate or impersonation — removes it from the review queue.
  ARCHIVED
}

enum LeaveStatus {
  PENDING
  SUPERVISOR_APPROVED
  APPROVED
  REJECTED
  NEEDS_REVISION
  CANCELLED
  // An employee's self-cancellation of an already-APPROVED leave sits here
  // until a Supervisor/Admin approves or denies it — the leave stays
  // APPROVED (balance still deducted, schedule still shows it) the whole
  // time. Denying it reverts to preCancellationStatus; approving moves to
  // CANCELLED. Cancelling a PENDING/SUPERVISOR_APPROVED request (nothing
  // committed yet) or an ADMIN override skips this state entirely.
  CANCELLATION_PENDING
}

enum LeaveRequestNoteType {
  REJECTED
  RESUBMITTED
  CANCELLED
  // Written by denyCancellation() — records that a Supervisor/Admin denied
  // this employee's request to cancel their (already-APPROVED) leave, so
  // the request permanently loses its ability to be cancelled again (see
  // getCancellationEligibility) instead of silently looking like a normal
  // approved leave that never had a cancellation attempt.
  CANCELLATION_DENIED
}

// Identifies a leave type's statutory role (sex-eligibility, auto-enrollment
// on hire, maternity extension) independent of its admin-editable display
// name — see LeaveBalancesService.isEligibleForLeaveType and
// EmployeesService.assignGenderLeaveType.
enum LeaveTypeKind {
  GENERAL
  MATERNITY
  PATERNITY
}

enum FaceEnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum Sex {
  MALE
  FEMALE
}

model User {
  id                     String             @id @default(uuid())
  email                  String             @unique
  // Nullable so a new employee can be created without a password and log in
  // once with just their email; they're then forced to set one (see
  // mustChangePassword) which populates this and flips the flag back to false.
  passwordHash           String?            @map("password_hash")
  status                 UserStatus         @default(ACTIVE)
  // Pre-existing live-DB column not originally tracked in this schema file (see the
  // `divisions`/`sections` note below) — mirrored as-is so `prisma db push` does not drop it.
  mustChangePassword     Boolean            @default(false) @map("must_change_password")
  defaultView            DefaultView?       @map("default_view")
  lastLoginAt            DateTime?          @map("last_login_at")
  // Bumped whenever this account's role is forcibly changed by someone else
  // (e.g. losing ADMIN when a replacement admin is added) — embedded in every
  // issued JWT and checked on each request so already-issued tokens are
  // instantly rejected instead of staying valid until their 15m expiry.
  tokenVersion           Int                @default(0) @map("token_version")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  employee               Employee?
  userRoles              UserRole[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  announcements          Announcement[]
  passwordResetOtps      PasswordResetOtp[]
  reviewedLeaveRequests  LeaveRequest[]
  reviewedAttendanceLogs AttendanceLog[]
  leaveRequestNotes      LeaveRequestNote[]
  createdLeaveTypes      LeaveType[]        @relation("LeaveTypeCreatedBy")
  updatedLeaveTypes      LeaveType[]        @relation("LeaveTypeUpdatedBy")
  createdShifts          Shift[]            @relation("ShiftCreatedBy")
  updatedShifts          Shift[]            @relation("ShiftUpdatedBy")

  @@map("users")
}

model PasswordResetOtp {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_otps")
}

model Role {
  id          String           @id @default(uuid())
  code        RoleCode         @unique
  name        String
  description String?
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  module      String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  // When the role was granted — lets login-time admin eviction tell the
  // newly-appointed admin apart from the outgoing one (see
  // AuthService.evictOutrankedAdmins).
  assignedAt DateTime @default(now()) @map("assigned_at")
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Department {
  id             String         @id @default(uuid())
  name           String         @unique
  isActive       Boolean        @default(true) @map("is_active")
  // "BOTH" means no restriction — HR chooses per employee. Any other code
  // forces every employee in this department to that mode (see
  // DepartmentsService.update's cascade and EmployeesService.resolveAttendanceMode).
  attendanceMode String         @default("BOTH") @map("attendance_mode")
  attendanceModeRef AttendanceMode @relation("DepartmentAttendanceMode", fields: [attendanceMode], references: [code])
  division_id    String?
  divisions      divisions?     @relation(fields: [division_id], references: [id])
  employees      Employee[]
  sections       sections[]
  workLocations  WorkLocation[]

  @@index([division_id])
  @@index([attendanceMode])
  @@map("departments")
}

// Pre-existing live-DB tables not originally tracked in this schema file
// (created directly against the shared dev database outside of Prisma migrations).
// Mirrored here as-is so `prisma db push` does not drop them.
model divisions {
  id          String       @id
  name        String       @unique
  departments Department[]
}

model sections {
  id            String     @id
  name          String
  department_id String
  employees     Employee[]
  departments   Department @relation(fields: [department_id], references: [id])

  @@unique([department_id, name])
  @@index([department_id])
}

model id_sequences {
  year        Int @id
  last_number Int @default(0)
}

model Position {
  id        String     @id @default(uuid())
  title     String
  employees Employee[]

  @@map("positions")
}

model Employee {
  id                   String                 @id @default(uuid())
  userId               String                 @unique @map("user_id")
  employeeNo           String                 @unique @map("employee_no")
  firstName            String                 @map("first_name")
  lastName             String                 @map("last_name")
  departmentId         String                 @map("department_id")
  positionId           String                 @map("position_id")
  employmentStatus     EmploymentStatus       @default(REGULAR) @map("employment_status")
  attendanceMode       String                 @default("FIXED") @map("attendance_mode")
  attendanceModeRef    AttendanceMode         @relation("EmployeeAttendanceMode", fields: [attendanceMode], references: [code])
  hireDate             DateTime               @map("hire_date")
  supervisorId         String?                @map("supervisor_id")
  contactNumber        String?                @map("contact_number")
  profilePhotoData     String?                @map("profile_photo_data")
  profilePhotoMimeType String?                @map("profile_photo_mime_type")
  birthdate            DateTime?
  section_id           String?
  sex                  Sex?
  soloParentStatus     SoloParentStatus       @default(NOT_APPLICABLE) @map("solo_parent_status")
  // Confident face-mismatch strikes ("this is a different person," not a
  // borderline match or a geofence failure) for the current calendar day —
  // see FaceVerificationService.matchEmployeeFace. Resets to 1 the first
  // time a mismatch lands on a new day (faceMismatchCountDate no longer
  // matches today), so a supervisor is notified again on that day's 3rd
  // strike rather than staying silently maxed out forever.
  faceMismatchCount     Int                    @default(0) @map("face_mismatch_count")
  faceMismatchCountDate DateTime?              @map("face_mismatch_count_date")
  // Borderline ("PENDING_REVIEW") flagged attendance attempts for the
  // current calendar day — see AttendanceService.submit()'s shouldFlag
  // branch. Every flagged attempt is still logged to the admin/supervisor
  // review queue immediately; this only gates the notification, so a
  // supervisor isn't paged over a single bad-lighting/angle misfire. Resets
  // to 1 the first time a flag lands on a new day, same as faceMismatchCount.
  flaggedAttemptCount     Int                  @default(0) @map("flagged_attempt_count")
  flaggedAttemptCountDate DateTime?            @map("flagged_attempt_count_date")
  // Null = Consent Pending, set = Consent Accepted. The employee accepts
  // this on first mobile login (FaceConsentScreen); Face Registration on the
  // admin side is blocked until it's set — see FaceRegistrationPage's
  // consent-required modal and EmployeesService.acceptFaceConsent.
  faceConsentAcceptedAt DateTime?              @map("face_consent_accepted_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  sections             sections?              @relation(fields: [section_id], references: [id])
  user                 User                   @relation(fields: [userId], references: [id])
  department           Department             @relation(fields: [departmentId], references: [id])
  position             Position               @relation(fields: [positionId], references: [id])
  supervisor           Employee?              @relation("SupervisorTeam", fields: [supervisorId], references: [id])
  teamMembers          Employee[]             @relation("SupervisorTeam")
  attendanceRecords    AttendanceRecord[]
  attendanceLogs       AttendanceLog[]
  faceProfiles         FaceProfile[]
  leaveRequests        LeaveRequest[]
  leaveBalances        LeaveBalance[]
  undertimeFilings     UndertimeFiling[]
  schedules            EmployeeSchedule[]
  workLocations        WorkLocationEmployee[]

  @@index([departmentId])
  @@index([supervisorId])
  @@index([section_id])
  @@index([attendanceMode])
  @@map("employees")
}

model WorkLocation {
  id                    String                 @id @default(uuid())
  name                  String
  latitude              Decimal
  longitude             Decimal
  radiusMeters          Decimal                @map("radius_meters")
  allowedAccuracyMeters Decimal                @map("allowed_accuracy_meters")
  isActive              Boolean                @default(true) @map("is_active")
  // Classifies the area itself as an Office or a Field site. A FIELD employee's
  // visit here is auto-tagged with this same type (see attendance.service.ts),
  // so a field technician who checks in at an office-classified area is
  // recorded as an OFFICE visit rather than a FIELD one.
  type                  AttendanceRecordType   @default(OFFICE)
  // Null = a global/shared area, visible to every department (e.g. HQ).
  // Set automatically to the creating Supervisor's department and never
  // client-editable by a Supervisor afterwards — see supervisor-scope.util.
  departmentId          String?                @map("department_id")
  department            Department?            @relation(fields: [departmentId], references: [id])
  employees             WorkLocationEmployee[]
  attendanceLogs        AttendanceLog[]
  attendanceRecords     AttendanceRecord[]

  @@index([departmentId])
  @@map("work_locations")
}

model WorkLocationEmployee {
  id             String       @id @default(uuid())
  workLocationId String       @map("work_location_id")
  employeeId     String       @map("employee_id")
  assigned_at    DateTime     @default(now())
  workLocation   WorkLocation @relation(fields: [workLocationId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([workLocationId, employeeId])
  @@index([workLocationId])
  @@index([employeeId])
  @@map("work_location_employees")
}

model AttendanceRecord {
  id               String               @id @default(uuid())
  employeeId       String               @map("employee_id")
  attendanceDate   DateTime             @map("attendance_date")
  // Scopes visit sequencing per kind of attendance — a BOTH-mode employee's
  // single daily office record and however many field visits that same day
  // each number their own visitNumber starting at 1, without colliding.
  recordType       AttendanceRecordType @default(OFFICE)
  visitNumber      Int                  @default(1) @map("visit_number")
  workLocationId   String?              @map("work_location_id")
  timeInAt         DateTime?            @map("time_in_at")
  // Effective OFFICE time-in used for totalMinutes math, distinct from the
  // raw timeInAt capture instant — see computeRenderTimeIn. Null for FIELD
  // records and any OFFICE time-in with no resolvable shift.
  renderTimeInAt   DateTime?            @map("render_time_in_at")
  timeOutAt        DateTime?            @map("time_out_at")
  // Optional, OFFICE-only lunch break window — logged for DTR/admin
  // visibility only, never deducted from totalMinutes/late/undertime math.
  lunchOutAt       DateTime?            @map("lunch_out_at")
  lunchInAt        DateTime?            @map("lunch_in_at")
  status           AttendanceStatus     @default(PENDING_REVIEW)
  totalMinutes     Int                  @default(0) @map("total_minutes")
  lateMinutes      Int                  @default(0) @map("late_minutes")
  undertimeMinutes Int                  @default(0) @map("undertime_minutes")
  shiftId          String?              @map("shift_id")
  employee         Employee             @relation(fields: [employeeId], references: [id])
  workLocation     WorkLocation?        @relation(fields: [workLocationId], references: [id])
  shift            Shift?               @relation(fields: [shiftId], references: [id])
  logs             AttendanceLog[]

  @@unique([employeeId, attendanceDate, recordType, visitNumber])
  @@index([attendanceDate])
  @@index([workLocationId])
  @@map("attendance_records")
}

model AttendanceLog {
  id                     String                @id @default(uuid())
  attendanceRecordId     String?               @map("attendance_record_id")
  employeeId             String                @map("employee_id")
  logType                AttendanceLogType     @map("log_type")
  capturedAt             DateTime              @default(now()) @map("captured_at")
  latitude               Decimal
  longitude              Decimal
  gpsAccuracyMeters      Decimal               @map("gps_accuracy_meters")
  distanceFromSiteMeters Decimal               @map("distance_from_site_meters")
  workLocationId         String?               @map("work_location_id")
  faceLivenessScore      Decimal?              @map("face_liveness_score")
  faceSimilarityScore    Decimal?              @map("face_similarity_score")
  verificationStatus     VerificationStatus    @map("verification_status")
  deviceId               String                @map("device_id")
  failureReason          String?               @map("failure_reason")
  faceImageData          String?               @map("face_image_data")
  faceImageMimeType      String?               @map("face_image_mime_type")
  // Set for every new log going forward — lets a flagged log (no
  // AttendanceRecord yet) be turned into one later at admin-review time
  // without re-deriving employee state, which may have moved on by then.
  attendanceDate         DateTime?             @map("attendance_date")
  recordType             AttendanceRecordType? @map("record_type")
  visitNumber            Int?                  @map("visit_number")
  // Populated when an admin/supervisor resolves a flagged (PENDING_REVIEW,
  // attendanceRecordId null) log — either validating it (-> APPROVED, DTR
  // created) or confirming it as a fake attendance attempt (-> FAKE_ATTEMPT).
  reviewedAt             DateTime?             @map("reviewed_at")
  reviewedBy             String?               @map("reviewed_by")
  reviewRemarks          String?               @map("review_remarks")
  attendanceRecord       AttendanceRecord?     @relation(fields: [attendanceRecordId], references: [id])
  employee               Employee              @relation(fields: [employeeId], references: [id])
  workLocation           WorkLocation?         @relation(fields: [workLocationId], references: [id])
  reviewer               User?                 @relation(fields: [reviewedBy], references: [id])

  @@index([employeeId, capturedAt])
  @@index([verificationStatus])
  @@index([workLocationId])
  @@map("attendance_logs")
}

model FaceProfile {
  id                 String               @id @default(uuid())
  employeeId         String               @map("employee_id")
  provider           String               @default("aws_rekognition")
  providerFaceId     String?              @map("provider_face_id")
  referenceImagePath String?              @map("reference_image_path")
  referenceImageData String?              @map("reference_image_data")
  descriptors        Json?                @map("descriptors")
  enrollmentStatus   FaceEnrollmentStatus @default(PENDING) @map("enrollment_status")
  enrolledAt         DateTime?            @map("enrolled_at")
  isArchived         Boolean              @default(false) @map("is_archived")
  employee           Employee             @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("face_profiles")
}

model LeaveType {
  id                          String             @id @default(uuid())
  name                        String             @unique
  defaultDays                 Decimal            @map("default_days")
  requiresDocument            Boolean            @default(false) @map("requires_document")
  supportingDocumentAfterDays Int?               @map("supporting_document_after_days")
  requiresHrValidation        Boolean            @default(false) @map("requires_hr_validation")
  requiresEhsActivation       Boolean            @default(false) @map("requires_ehs_activation")
  ehsActivated                Boolean            @default(false) @map("ehs_activated")
  allowWithoutPay             Boolean            @default(false) @map("allow_without_pay")
  isTransferable              Boolean            @default(false) @map("is_transferable")
  isAutoCredited              Boolean            @default(false) @map("is_auto_credited")
  applicableStatuses          EmploymentStatus[] @default([]) @map("applicable_statuses")
  isActive                    Boolean            @default(true) @map("is_active")
  // Statutory role of this type (sex-eligibility, auto-enrollment on hire,
  // maternity extension) — see LeaveTypeKind. Independent of `name`, which
  // HR can freely rename without affecting this behavior.
  kind                         LeaveTypeKind      @default(GENERAL)
  isUnlimitedDays             Boolean            @default(false) @map("is_unlimited_days")
  // True for leave types an employee cannot self-select until HR/Admin has
  // explicitly granted them a balance for the year (Solo Parent, Study
  // Leave, Added Paternity Leave) — see LeaveBalancesService.findForEmployee.
  requiresAdminGrant          Boolean            @default(false) @map("requires_admin_grant")
  // True for leave types where a single request is always exactly one day
  // (Sick Leave, Emergency Leave) — the application form skips the end-date
  // picker and forces startDate = endDate, totalDays = 1.
  isSingleDayOnly             Boolean            @default(false) @map("is_single_day_only")
  // False for leave types that must be filed for today only, never a future
  // date (Sick Leave). True (default) leaves every existing type's behavior
  // unchanged — e.g. Compassionate Leave, which may be filed ahead of time,
  // including for a doctor's appointment (a reason under this type, not a
  // separate leave type).
  advanceFilingAllowed         Boolean            @default(true) @map("advance_filing_allowed")
  cancellationAllowed          Boolean            @default(false) @map("cancellation_allowed")
  cancellationCutoffValue      Int?               @map("cancellation_cutoff_value")
  cancellationCutoffUnit       String?            @map("cancellation_cutoff_unit")
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")
  createdBy                   String?            @map("created_by")
  updatedBy                   String?            @map("updated_by")
  leaveRequests               LeaveRequest[]
  leaveBalances               LeaveBalance[]
  createdByUser               User?              @relation("LeaveTypeCreatedBy", fields: [createdBy], references: [id])
  updatedByUser               User?              @relation("LeaveTypeUpdatedBy", fields: [updatedBy], references: [id])

  @@map("leave_types")
}

model LeaveRequest {
  id                 String             @id @default(uuid())
  employeeId         String             @map("employee_id")
  leaveTypeId        String             @map("leave_type_id")
  startDate          DateTime           @map("start_date")
  endDate            DateTime           @map("end_date")
  totalDays          Decimal            @map("total_days")
  reason             String
  status             LeaveStatus        @default(PENDING)
  reviewedBy         String?            @map("reviewed_by")
  reviewedAt         DateTime?          @map("reviewed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  attachmentPath     String?            @map("attachment_path")
  attachmentName     String?            @map("attachment_name")
  attachmentMimeType String?            @map("attachment_mime_type")
  attachmentData     String?            @map("attachment_data")
  extensionRequested Boolean            @default(false) @map("extension_requested")
  extensionApproved  Boolean?           @map("extension_approved")
  // Only set while status is CANCELLATION_PENDING — the status to revert to
  // if a Supervisor/Admin denies the employee's cancellation request.
  preCancellationStatus LeaveStatus?    @map("pre_cancellation_status")
  employee           Employee           @relation(fields: [employeeId], references: [id])
  leaveType          LeaveType          @relation(fields: [leaveTypeId], references: [id])
  reviewer           User?              @relation(fields: [reviewedBy], references: [id])
  notes              LeaveRequestNote[]

  @@index([employeeId, status])
  @@index([startDate])
  @@map("leave_requests")
}

// The durable, ordered thread behind the reject -> "needs additional
// requirements" -> employee resubmits -> re-review loop. Kept separate from
// AuditLog because that table's LeaveRequest lookup only ever surfaces the
// single most recent entry (see LeaveService.findAll), which breaks down once
// a request can cycle through multiple rejection/resubmission rounds.
model LeaveRequestNote {
  id                             String               @id @default(uuid())
  leaveRequestId                 String               @map("leave_request_id")
  type                           LeaveRequestNoteType
  message                        String?
  requiresAdditionalRequirements Boolean              @default(false) @map("requires_additional_requirements")
  requirementDetails             String?              @map("requirement_details")
  attachmentName                 String?              @map("attachment_name")
  attachmentMimeType             String?              @map("attachment_mime_type")
  attachmentData                 String?              @map("attachment_data")
  authorUserId                   String?              @map("author_user_id")
  createdAt                      DateTime             @default(now()) @map("created_at")
  leaveRequest                   LeaveRequest         @relation(fields: [leaveRequestId], references: [id])
  author                         User?                @relation(fields: [authorUserId], references: [id])

  @@index([leaveRequestId])
  @@map("leave_request_notes")
}

model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String    @map("employee_id")
  leaveTypeId String    @map("leave_type_id")
  year        Int
  earnedDays  Decimal   @map("earned_days")
  usedDays    Decimal   @default(0) @map("used_days")
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

// A self-filed notice of intent to render undertime, independent of the
// automatic AttendanceRecord.undertimeMinutes computed from actual clock-out
// vs. shift end. Filing is only permitted on the 8th/23rd of the month, capped
// at 3 per employee per calendar month — both enforced in UndertimeService,
// never trusted from the client. No approval workflow: filing itself is the
// record, matching what HR described (no mention of a review step, unlike
// leave requests).
model UndertimeFiling {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  filingDate DateTime @map("filing_date")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, filingDate])
  @@map("undertime_filings")
}

model Shift {
  id                        String             @id @default(uuid())
  name                      String
  startTime                 String             @map("start_time")
  endTime                   String             @map("end_time")
  morningBreakMinutes       Int                @default(15) @map("morning_break_minutes")
  afternoonBreakMinutes     Int                @default(15) @map("afternoon_break_minutes")
  lunchBreakMinutes         Int                @default(60) @map("lunch_break_minutes")
  enableRounding            Boolean            @default(false) @map("enable_rounding")
  roundingIntervalMinutes   Int                @default(15) @map("rounding_interval_minutes")
  lateThresholdMinutes      Int                @default(0) @map("late_threshold_minutes")
  undertimeThresholdMinutes Int                @default(0) @map("undertime_threshold_minutes")
  autoShiftAdjustment       Boolean            @default(false) @map("auto_shift_adjustment")
  // Days this shift runs, 0=Sunday..6=Saturday (matches JS Date.getDay()).
  // Mon-Fri by default.
  workingDays               Int[]              @default([1, 2, 3, 4, 5]) @map("working_days")
  isActive                  Boolean            @default(true) @map("is_active")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")
  createdBy                 String?            @map("created_by")
  updatedBy                 String?            @map("updated_by")
  schedules                 EmployeeSchedule[]
  attendanceRecords         AttendanceRecord[]
  createdByUser             User?              @relation("ShiftCreatedBy", fields: [createdBy], references: [id])
  updatedByUser             User?              @relation("ShiftUpdatedBy", fields: [updatedBy], references: [id])

  @@map("shifts")
}

model EmployeeSchedule {
  id         String    @id @default(uuid())
  employeeId String    @map("employee_id")
  shiftId    String    @map("shift_id")
  startsOn   DateTime  @map("starts_on")
  endsOn     DateTime? @map("ends_on")
  // This employee's actual working days for this assignment — defaults to
  // the shift's own workingDays but can be overridden per employee (e.g. a
  // part-timer on the same shift template who only works some of its days).
  // Same 0=Sunday..6=Saturday encoding as Shift.workingDays.
  workingDays Int[]    @default([1, 2, 3, 4, 5]) @map("working_days")
  // Manual archive, independent of startsOn/endsOn — lets HR hide a mistaken
  // or duplicate assignment without needing to backdate an end date.
  isActive   Boolean   @default(true) @map("is_active")
  employee   Employee  @relation(fields: [employeeId], references: [id])
  shift      Shift     @relation(fields: [shiftId], references: [id])

  @@index([employeeId])
  @@map("employee_schedules")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  message   String
  type      String?
  entityId  String?   @map("entity_id")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model Announcement {
  id                    String             @id @default(uuid())
  title                 String
  message               String
  status                AnnouncementStatus @default(PUBLISHED)
  // Only set when status is SCHEDULED — AnnouncementsService's cron
  // publishes (resolves recipients + notifies) once this time has passed.
  scheduledAt           DateTime?          @map("scheduled_at")
  // Set when the announcement actually goes out (immediately for PUBLISHED,
  // or by the scheduler for SCHEDULED). Null for DRAFT.
  publishedAt           DateTime?          @map("published_at")
  // All target fields empty/false = all active employees. Otherwise the
  // recipient set is the UNION of: employees in targetDepartmentIds,
  // employees with the SUPERVISOR role (if targetSupervisorsOnly), and
  // employees in targetEmployeeIds — see resolveTargetEmployees. Plain
  // scalar arrays, same pattern as LeaveType.applicableStatuses — no join
  // table needed.
  targetDepartmentIds   String[]           @map("target_department_ids")
  targetSupervisorsOnly Boolean            @default(false) @map("target_supervisors_only")
  targetEmployeeIds     String[]           @map("target_employee_ids")
  createdByUserId       String?            @map("created_by_user_id")
  createdBy             User?              @relation(fields: [createdByUserId], references: [id])
  createdAt             DateTime           @default(now()) @map("created_at")

  @@map("announcements")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
